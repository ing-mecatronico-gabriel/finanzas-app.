# ==========================================================
# CONFIGURACIÓN DE ENTORNO — FINANZASAPP
# Copia este archivo como .env dentro de la carpeta /backend:
# cp .env.example backend/.env
# ==========================================================

# Puerto del Servidor
PORT=3000
NODE_ENV=development

# Clave Secreta para Tokens JWT (Generar una cadena aleatoria y segura en producción)
JWT_SECRET=super_secreto_finanzas_app_token_jwt_2026_xyz!@#
JWT_EXPIRES_IN=30d

# ----------------------------------------------------------
# BASE DE DATOS EN LA NUBE (POSTGRESQL / SUPABASE / NEON / RAILWAY)
# ----------------------------------------------------------
# Para conectar a tu base de datos en la nube (PostgreSQL / Supabase):
# Ejemplo Supabase: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Ejemplo Neon: postgresql://usuario:password@ep-cool-cloud.us-east-2.aws.neon.tech/finanzasdb?sslmode=require
DATABASE_URL=

# Si dejas DATABASE_URL vacío, el backend iniciará automáticamente en modo de almacenamiento local embebido
# para que puedas probar el sistema de inmediato sin configurar un servidor Postgres remoto.

# Configuración de CORS (Dominios permitidos en producción, o * para desarrollo)
CORS_ORIGIN=*

# Moneda por Defecto
DEFAULT_CURRENCY=COP
